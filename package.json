{
	"name": "newera",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:integration": "npm run build && node --test tests/integration.test.mjs",
		"test": "node --experimental-strip-types --import ./tests/loader.mjs --test tests/theater.test.mjs tests/oev.test.mjs tests/relationships.test.mjs tests/appearance.test.mjs tests/memory-search.test.mjs tests/generation-history.test.mjs tests/providers.test.mjs",
		"lore:build": "node skills/newera-lore-authoring/scripts/build-lore.mjs",
		"lore:validate": "node skills/newera-lore-authoring/scripts/validate-lore.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@lancedb/lancedb": "^0.40.0",
		"apache-arrow": "^18.1.0"
	}
}
