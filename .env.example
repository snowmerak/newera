NEWERA_OEV_BASE_URL=http://macstudio:12821/v1
# Default model for binary participation and structured action generation.
NEWERA_DECISION_MODEL=gemma4-26b
NEWERA_TEXT_MODEL=gemma4-26b
NEWERA_DECISION_TIMEOUT_MS=120000
NEWERA_LLM_TIMEOUT_MS=120000
NEWERA_MAX_OUTPUT_TOKENS=512
NEWERA_MAX_RETRIES=2
NEWERA_RETRY_BASE_MS=1000
NEWERA_RETRY_MAX_MS=8000
# NEWERA_DATA_DIR=./data
# NEWERA_MODEL_CONFIG=./data/models.json

# Maximum tokens for each structured observation/relationship reflection.
NEWERA_REFLECTION_MAX_OUTPUT_TOKENS=1024
# Rolling dialogue/action/movement history for actor generation only (estimated tokens).
NEWERA_GENERATION_HISTORY_TOKENS=32768

# Long-term recall: LanceDB BM25 + OEV embeddings. Recent history remains directly available.
NEWERA_MEMORY_ENABLED=true
NEWERA_EMBEDDING_MODEL=embeddinggemma2
NEWERA_EMBEDDING_DIMENSIONS=768
NEWERA_EMBEDDING_TIMEOUT_MS=10000
NEWERA_MEMORY_TOP_K=4
NEWERA_MEMORY_MAX_BYTES=6000
# ngram works without a dictionary. lindera/ko-dic requires a compiled Korean dictionary.
NEWERA_MEMORY_TOKENIZER=ngram
# NEWERA_MEMORY_DIR=./data/memory-lance
